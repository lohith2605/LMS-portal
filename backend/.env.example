# Backend Environment Variables
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
CLIENT_URL=http://localhost:5173

# Authentication & Session Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=8h
SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_WARNING_BEFORE_EXPIRY_MINUTES=3
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
SESSION_ACTIVITY_UPDATE_INTERVAL_SECONDS=60
TRUST_PROXY=false

# Two-Factor Authentication (2FA / MFA) Encryption Key (AES-256-GCM)
TOTP_ENCRYPTION_KEY=your_secure_32_character_totp_encryption_key

# Admin Provisioning Security Token
ADMIN_SETUP_TOKEN=your_secure_admin_provisioning_token

# Email Configuration (Optional - For Password Reset, Email OTP & Verification)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="LearnSpace" <your_email@example.com>

# Cloudinary Storage Configuration (For Assignment Submissions & Media)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Configuration (Phase 1)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Learning Activity & Streaks (Phases 1 & 2)
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_STUDY_INTERVAL_SECONDS=300

# Automated Assignment Deadline Reminders

ASSIGNMENT_REMINDER_24H_ENABLED=true
ASSIGNMENT_REMINDER_1H_ENABLED=true
ASSIGNMENT_REMINDER_INTERVAL_MINUTES=5
ASSIGNMENT_REMINDER_EMAIL_ENABLED=true
ASSIGNMENT_REMINDER_NOTIFICATION_ENABLED=true

# Firebase Admin SDK Credentials (For Google Authentication)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
